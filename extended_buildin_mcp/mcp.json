{
  "version": 1,
  "servers": [
    {
      "id": "stock-datasource",
      "name": "股票数据服务",
      "type": "http",
      "url": "http://116.62.181.59:8080/mcp",
      "args": [],
      "env": {},
      "description": "股票行情 + 新闻",
      "enabled": true
    },
    {
      "id": "mobile-control",
      "name": "手机运营控制",
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mobilenext/mobile-mcp@latest"],
      "description": "手机运营控制, 控制你的手机完成自动化任务",
      "enable": true
    },
    {
      "id": "multimedia-creator",
      "name": "视频/图片生成（Agnes 2.5）",
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "${bundled:hosted_mcps/agnes-video-25}",
        "agnes-video-25-mcp"
      ],
      "env": {
        "AGNES_API_KEY": "${env:AGNES_API_KEY}",
        "AGNES_BASE_URL": "https://api.agnes-ai.cn/v1",
        "AGNES_OUTPUT_DIR": "${env:AGNES_OUTPUT_DIR}"
      },
      "description": "Agnes Video 2.5 / 2.5 Flash（reference / keyframe / text 三模式）+ Agnes Image 2.5 Flash（text-to-image / img2img）。uvx 走 bundled uvx (Windows) 或系统 uvx (macOS/Linux)。",
      "enabled": true
    }
  ]
}