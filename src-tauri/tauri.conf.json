{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HamunaAgent",
  "version": "0.3.152",
  "identifier": "com.hamuna.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/ensure_cuse_stub.mjs && npm run build:server && npm run build:bridge && npm run dev:web",
    "beforeBuildCommand": "node scripts/ensure_cuse_stub.mjs && npm run build:web && npm run build:server && npm run build:bridge && npm run build:cli"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.hamuna/**"
        ]
      },
      "csp": "default-src 'self' ipc: tauri: asset: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.font.im; font-src 'self' data: https://fonts.gstatic.com https://fonts.gstatic.font.im; connect-src 'self' ipc: tauri: asset: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://download.hamuna.io; img-src 'self' data: blob: asset: hamuna: http://hamuna.localhost http://asset.localhost https://asset.localhost https://download.hamuna.io https:; media-src 'self' data: blob: asset: hamuna: http://hamuna.localhost http://asset.localhost https://asset.localhost https:;",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src-tauri/resources/server-dist.js": "server-dist.js",
      "../src-tauri/resources/plugin-bridge-dist.mjs": "plugin-bridge-dist.mjs",
      "../src/server/plugin-bridge/sdk-shim": "plugin-bridge-sdk-shim",
      "../src-tauri/resources/claude-agent-sdk": "claude-agent-sdk",
      "../src-tauri/resources/sharp-runtime": "sharp-runtime",
      "../src-tauri/resources/tsx-runtime": "tsx-runtime",
      "../src-tauri/resources/kb-runtime": "node_modules",
      "../src-tauri/resources/nodejs": "nodejs",
      "../src/shared": "shared",
      "../bundled-skills": "bundled-skills",
      "../bundled-agents": "bundled-agents",
      "../extended_buildin_mcp": "extended_buildin_mcp",
      "../hosted_mcps/agnes-video-25": "hosted_mcps/agnes-video-25",
      "../src-tauri/resources/cli": "cli",
      "../src-tauri/resources/cuse-latest.json": "cuse-latest.json",
      "../src-tauri/resources/assets/feedback_qr_code.png": "assets/feedback_qr_code.png",
      "../mino": "mino",
      "infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "infoplist/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings"
    },
    "externalBin": [
      "binaries/cuse"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": null,
      "allowDowngrades": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "SimpChinese": "nsis/languages/SimpChinese.nsh",
          "English": "nsis/languages/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3MUQ2M0E4MUU3NDJENEEKUlVSS0xYUWVxR01kTjVObEhudHI0SnFmRXorNy9wbGVZVUhSTCtpemFydFBRb2E4RU1LQ0tkb3cK",
      "endpoints": [
        "https://pub-2d5b7e0153e94f999bdfea020fb31629.r2.dev/update/{{target}}.json"
      ]
    }
  }
}
